static func get_effect(skill_name: String) -> String:
	return str(EFFECTS.get(skill_name, ""))


## 流派悬停介绍（依据项目书 4.1 流派系统总览：定位 / 核心资源 / 系数）
const FLOW_EFFECTS: Dictionary = {
	"守拙": "防御反击：成功格挡积攒「墨盾」（5 层）；血厚 1.40，移速 0.90。如山而立，以大盾换时机。",
	"点墨": "远程法系：攻击命中积攒「砚池」（100%）；伤害 1.30，血量 0.90。以墨弹拉开距离。",
	"藏锋": "刺客爆发：闪避积攒「残影」（3→5 层）；伤害 1.20，血量 0.80，移速 1.25。高机动找背刺。",
	"归砚": "召唤辅助：驭蝶积攒「墨魂」（5→7 层）；伤害 0.85，血量 1.00。以召唤物攻守兼具。",
	"点睛": "燃烧爆发：以血为墨存「泪痕」；伤害 1.60，血量 0.60。低血高伤，刀尖起舞。",
}


static func get_flow_desc(flow_name: String) -> String:
	return str(FLOW_EFFECTS.get(flow_name, ""))
